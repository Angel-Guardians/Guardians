# ===========================
# Guardian environment example
# Copy to .env and fill in.
# ===========================

# --- Always-on services ---
WAKEWORD_MODEL_PATH=./models/hey_guardian.onnx
WAKEWORD_THRESHOLD=0.6
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# =====================================================================
# LLM backend — provider-agnostic. The app talks only to backend.llm,
# so switching cloud <-> local DGX Spark is a change to THESE vars only.
# Every supported backend (OpenAI, vLLM, NIM, Ollama) is OpenAI-compatible.
# =====================================================================

# --- Active backend: OpenAI cloud (rapid dev) ---
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-replace-me
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=          # optional cap; leave unset for model default
LLM_SUPPORTS_TOOLS=true    # set false for local models with unreliable tool-calling
LLM_TIMEOUT=60

# --- To switch to a local model on NVIDIA DGX Spark (vLLM / NIM), set: ---
#   LLM_PROVIDER=local
#   LLM_BASE_URL=http://dgx-spark:8000/v1
#   LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
#   LLM_API_KEY=not-needed
#
# --- Or local Ollama: ---
#   LLM_PROVIDER=local
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_MODEL=llama3.1:8b-instruct-q4_K_M
#   LLM_API_KEY=not-needed

# Legacy OpenAI names below are still read as a fallback if LLM_* are unset.
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# --- LangSmith observability ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_replace-me
LANGSMITH_PROJECT=guardian-phase0

# --- Database ---
DATABASE_URL=sqlite:///./guardian.db
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace-me
INFLUXDB_ORG=guardian
INFLUXDB_BUCKET=vitals

# --- Wearable ---
POLAR_H10_MAC=XX:XX:XX:XX:XX:XX

# --- Twilio (Day-3 real comms) ---
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+15555550100
TWILIO_TEST_TO_NUMBER=+15555550111

# --- FHIR (Day-3 mock push) ---
FHIR_BASE_URL=http://hapi.fhir.org/baseR4

# --- Backend / API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- CPU pinning for always-on processes ---
# Comma- or dash-range pinned via taskset/cgroups in production.
ALWAYS_ON_CPU_CORES=0-5
