# ===========================
# Guardian environment example
# Copy to .env and fill in.
# ===========================

# --- Always-on services ---
WAKEWORD_MODEL_PATH=./models/hey_guardian.onnx
WAKEWORD_THRESHOLD=0.6
WHISPER_MODEL=small.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# --- LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL_GENERALIST=llama3.1:8b-instruct-q4_K_M
LLM_MODEL_CLINICAL=meditron:7b
LLM_MODEL_CLASSIFIER=phi3.5:mini

# --- Database ---
DATABASE_URL=sqlite:///./guardian.db
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=replace-me
INFLUXDB_ORG=guardian
INFLUXDB_BUCKET=vitals

# --- Wearable ---
POLAR_H10_MAC=XX:XX:XX:XX:XX:XX

# --- Twilio (Day-3 real comms) ---
TWILIO_ACCOUNT_SID=replace-me
TWILIO_AUTH_TOKEN=replace-me
TWILIO_FROM_NUMBER=+15555550100
TWILIO_TEST_TO_NUMBER=+15555550111

# --- FHIR (Day-3 mock push) ---
FHIR_BASE_URL=http://hapi.fhir.org/baseR4

# --- Backend / API ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# --- CPU pinning for always-on processes ---
# Comma- or dash-range pinned via taskset/cgroups in production.
ALWAYS_ON_CPU_CORES=0-5
