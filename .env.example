# ============================================================
# Guardian environment. Copy to .env and fill in.
# Switching cloud <-> local DGX Spark is a change to LLM_* ONLY.
# ============================================================

# ---- LLM backend (provider-neutral; app talks only to backend.llm) ----
# Active backend: OpenAI cloud (fast iteration today)
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=sk-replace-me
LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=
LLM_SUPPORTS_TOOLS=true       # set false for local models with weak tool-calling
LLM_TIMEOUT=60

# ---- To run on the NVIDIA DGX Spark instead, comment the block above and use: ----
# Ollama on the Spark (simplest):
#   LLM_PROVIDER=local
#   LLM_BASE_URL=http://localhost:11434/v1   # via SSH tunnel; see SETUP_DGX_SPARK.md
#   LLM_MODEL=nemotron-3-nano:4b             # see MODELS.md; or any tag from `ollama list`
#   LLM_API_KEY=not-needed
# vLLM / NVIDIA NIM on the Spark:
#   LLM_BASE_URL=http://<spark-host>:8000/v1
#   LLM_MODEL=nvidia/nemotron-...

# Legacy fallbacks (read only if LLM_* are unset)
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# ---- LangSmith observability (optional; no-op if unset) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=lsv2_replace-me
LANGSMITH_PROJECT=guardian

# ---- Database ----
# SQLite by default (zero setup). For pgvector RAG, start Postgres (docker compose
# up -d postgres) and set:
#   DATABASE_URL=postgresql+psycopg://guardian:guardian@localhost:5432/guardian
DATABASE_URL=sqlite:///./guardian.db

# ---- Person-history recall (RAG) ----
# keyword = always-on fallback over data/personas/*.md (no DB needed)
# pgvector = real embeddings (requires Postgres + `pip install -e ".[rag]"`)
MEMORY_BACKEND=keyword

# ---- Lab records / external health-record sources ----
# Where uploaded/fetched result documents (PDFs) are stored on disk.
LAB_DOCUMENTS_DIR=./data/lab_documents
# LifeLabs MyCareCompass (Ontario portal). No public patient API exists; the
# upload path is primary and the crawler is opt-in (see lifelabs_client.py).
LIFELABS_BASE_URL=https://on.mycarecompass.lifelabs.com
LIFELABS_USERNAME=
LIFELABS_PASSWORD=
LIFELABS_SESSION_DIR=./data/lifelabs_session

# ---- Backend / API ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO

# ---- Frozen for now: STT/TTS (see SETUP_VOICE.md to enable) ----
# WHISPER_MODEL=small.en           # STT (faster-whisper or NVIDIA Parakeet)
# KOKORO_VOICE_DEFAULT=af_nicole   # TTS (Kokoro)
