<?xml version="1.0" encoding="utf-8"?>
<!--
  The Guardian backend runs on the local network over plain HTTP (e.g.
  http://192.168.1.50:8000). Android blocks cleartext traffic by default, so we
  permit it here. This is appropriate for a LAN/dev deployment; for production,
  serve the backend over HTTPS and remove this allowance (or scope it to your
  backend's domain).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
